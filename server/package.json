{
  "name": "colorwars-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/seed.ts",
    "setup": "prisma db push && prisma generate && tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
